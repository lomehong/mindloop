# mindloop 配置文件模板
# ============================================================================
# 用法：复制本文件为 <状态根目录>/.env（默认 %USERPROFILE%\.mindloop\.env，
# 可用 MINDLOOP_HOME 改），按需修改。CLI 启动时自动加载；
# 显式设置的环境变量优先于此文件。

# ============================================================================
# 一、模型（核心开关——切换模型/模式只改这一行）
# ============================================================================

# provider 通常不用设：按模型名自动推断
#   claude-*  → anthropic 端点
#   echo      → 本地占位（不联网、固定回复，体验流程用）
#   其余      → openai-compatible（glm-* 自动落到智谱端点）
MINDLOOP_MODEL=glm-5
# MINDLOOP_MODEL=echo

# API Key（glm-5 走智谱开放平台）
MINDLOOP_API_KEY=

# 服务地址。glm-* 留空时默认智谱国内端点；其他常见端点见下方备查
MINDLOOP_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选：强制指定供应商（留空自动推断）
# MINDLOOP_PROVIDER=openai-compatible

# ============================================================================
# 二、常见端点备查
# ============================================================================
# 智谱国际 (z.ai)   https://api.z.ai/api/paas/v4
# OpenAI 官方       https://api.openai.com/v1
# OpenRouter        https://openrouter.ai/api/v1
# Ollama 本地       http://127.0.0.1:11434/v1      （key 随便非空，如 ollama）
# llama.cpp/vLLM    http://127.0.0.1:8080/v1

# claude 模型走 anthropic 原生端点（默认 https://api.anthropic.com）；
# key 依次回退：ANTHROPIC_API_KEY / OPENAI_API_KEY

# ============================================================================
# 三、多提供商档案（providers.json，可选；仪表盘配置页可视化编辑）
# ============================================================================
# 在多个提供商/端点之间切换（按档位各选模型）时，用 providers.json 声明
# 档案与档位绑定——非敏感，可随身份导出/分享；密钥仍只住 .env：
#   全局：<状态根>/providers.json      身份级覆盖：<身份目录>/providers.json
# 两级合并：同名档案身份级整体覆盖全局，tiers 逐档覆盖。文档结构：
# {
#   "version": 1,
#   "profiles": [
#     {"id": "glm", "label": "智谱",
#      "base_url": "https://open.bigmodel.cn/api/paas/v4",
#      "models": ["glm-5", "glm-4.5-air", "glm-4-flash"]}
#   ],
#   "tiers": {
#     "think":   {"profile": "glm", "model": "glm-5"},
#     "request": {"profile": "glm", "model": "glm-4.5-air"},
#     "summary": {"profile": "glm", "model": "glm-4-flash"}
#   }
# }
#
# 档案密钥按约定键读取（或在档案里用 api_key_env 引用任意键名）：
# MINDLOOP_PROFILE_GLM_API_KEY=
#
# 优先级：显式环境变量（MINDLOOP_MODEL / MINDLOOP_REQUEST_MODEL /
# MINDLOOP_SUMMARY_MODEL）优先于 providers.json 绑定；两者皆无 = 旧行为
# （按模型名推断）。改 providers.json 后重启思考者生效。

# ============================================================================
# 四、可选调优
# ============================================================================

# 输出预算（token）。思考型模型（glm-5* / glm-4.5* / deepseek-r* /
# o1/o3/o4 / qwq / 含 -thinking 的模型）的思考 token 计入输出预算，
# 默认 32768；其余模型 8192。
# 出现"思考耗尽了输出预算（finish=length，无可见内容）"时调大：
# MINDLOOP_MAX_TOKENS=65536
# 新思考型模型不在内置名单时追加前缀（逗号分隔，只增不减）：
# MINDLOOP_REASONING_MODELS=mine-new,kimi-think

# 双模型分层（可选，推荐）：自发的空闲唤醒用上面的 MINDLOOP_MODEL
# 思考档（便宜），反应式唤醒（人类来话、外部产物）升级到请求档
# （用好模型）。Headlong 的实测：成熟身份的空闲唤醒占绝大多数，
# 分层后安静日模型开销降 70-80%。两档用量在 usage/llm-usage.jsonl
# 里按模型名区分。未设则全部走思考档；请求档缺 key 时自动回落：
# MINDLOOP_REQUEST_MODEL=glm-4.5-air

# 摘要档（可选）：recap 摘要与记忆归纳用的模型；未设或不可用时
# 自动回落思考档：
# MINDLOOP_SUMMARY_MODEL=glm-4-flash

# 状态根目录（默认 %USERPROFILE%\.mindloop；Linux/macOS 为 ~/.mindloop）。
# 身份、轨迹、记忆、.env 都住在这里。一般不需要改：
# MINDLOOP_HOME=

# 仪表盘（mindloop web）可选环境变量：
# MINDLOOP_WEB_TOKEN=bearer-token   # 等效 --token；绑定非回环地址（如 0.0.0.0）时必填
# MINDLOOP_VIEWER_DIR=              # 前端构建产物目录；默认自动探测 web/static/build/client

# 流式回复（默认开启）：对话回复生成期间经 SSE 实时推送，仪表盘
# 对话页逐字渲染。设为 0 整体关闭，回复回退为落盘后一次性可见：
# MINDLOOP_STREAM=0

# ============================================================================
# 五、运行时自动注入（勿手填）
# ============================================================================
# MINDLOOP_RUN_ID         运行循环写入步骤时的 run 溯源 id
# MINDLOOP_WORKDIR        本轮工作目录
# MINDLOOP_EXE            mindloop 自身的绝对路径（沙箱内 agent 调
#                         "$MINDLOOP_EXE mem add ..." 写记忆用）
# MINDLOOP_IDENTITY_DIR   当前身份目录（沙箱内定位 persona/mcp.json 等）
# SKILLS_DIR              身份级技能库目录（agent cat $SKILLS_DIR/... 读取正文）
