{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mindloop",
  "version": "0.8.0",
  "identifier": "com.mindloop.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mindloop",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "viewer-static": "viewer"
    },
    "externalBin": ["binaries/mindloop"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
